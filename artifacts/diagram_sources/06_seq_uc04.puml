@startuml
' UC04 - Generate a park conservation report - Sequence Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam monochrome true

actor "Manager / Researcher" as U
participant "ReportView" as V
participant "ReportService" as S
participant "ConservationAPI" as API

== R1-R2 : Select filters ==
U -> V : open Reports
activate V
V --> U : permitted parks + filters
U -> V : park, dates, categories
V -> S : validate(criteria)
activate S
S --> V : ok
deactivate S

== R3-R5 : Generate from one snapshot ==
U -> V : Generate report
V -> S : generate(criteria)
activate S
S -> API : query(criteria)
activate API
API --> S : Snapshot (synced only + cutoff)
deactivate API
S -> S : aggregate(snapshot)
note right : counts, coverage,\nconflict trends
S --> V : ConservationReport
deactivate S
V --> U : results + cutoff + limitations
deactivate V

== R6 : Export same snapshot ==
U -> V : Export PDF or CSV
activate V
V -> S : export(reportId, format)
activate S
note right : identical snapshot ID\nand filters
S --> V : File
deactivate S
V --> U : download

@enduml
