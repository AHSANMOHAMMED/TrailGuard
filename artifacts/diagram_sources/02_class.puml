@startuml
' =============================================================================
' FULL CLASS DIAGRAM - Smart Wildlife Conservation System
' Group: Y3S2-NU-WE-02
' =============================================================================

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor black
  HeaderBackgroundColor black
  HeaderFontColor white
}

' ----- Domain entities -----
class Park {
  +parkId : UUID
  +name : String
  +region : String
  --
  +configureZones()
  +listRoutes()
}

class Officer {
  +officerId : UUID
  +name : String
  +role : OfficerRole
  --
  +isAvailable() : boolean
}

class PatrolRoute {
  +routeId : UUID
  +name : String
  --
  +assign(officerId)
}

class Patrol {
  +patrolId : UUID
  +status : Status
  +startedAt : DateTime
  --
  +start()
  +complete()
}

class Waypoint {
  +pointId : UUID
  +geo : GeoPoint
  +source : GPS|MANUAL
  +recordedAt : DateTime
}

class IncidentReport {
  +reportId : UUID
  +type : String
  +description : String
  +syncState : SyncState
  +observedAt : DateTime
  --
  +create()
  +validate()
}

class PhotoAttachment {
  +attachId : UUID
  +uri : String
  +mimeType : String
}

class Alert {
  +alertId : UUID
  +status : OPEN..CLOSED
  +confidence : String
  --
  +assign()
  +close()
}

class ResponseAssignment {
  +raId : UUID
  +officerId : UUID
  +deliveryState : DeliveryState
  +acknowledgedAt : DateTime
  --
  +acknowledge()
}

class Animal {
  +animalId : UUID
  +species : String
}

class GPSCollar {
  +collarId : UUID
  +active : boolean
  --
  +lastReading()
}

class LocationReading {
  +readingId : UUID
  +geo : GeoPoint
  +observedAt : DateTime
  +receivedAt : DateTime
}

class RiskZone {
  +zoneId : UUID
  +polygon : GeoPolygon
  +freshnessMinutes : int
  --
  +contains(point) : boolean
}

class CommunityReport {
  +crId : UUID
  +channel : SMS|APP
  +verified : boolean
}

class ConservationReport {
  +reportId : UUID
  +cutoff : DateTime
  +generatedAt : DateTime
}

class ReportCriteria {
  +parkId : UUID
  +from : Date
  +to : Date
  +categories : List
}

' ----- Application services -----
class PatrolService {
  +startPatrol(routeId) : Patrol
  +recordPoint(id, geo) : Waypoint
  +completePatrol(id)
}

class IncidentService {
  +createIncident(data) : IncidentReport
  +reviewImage(id, note)
}

class ConflictService {
  +ingestReading(reading)
  +assessRisk(reading) : boolean
  +getAlert(id) : Alert
  +assign(alertId, officerId) : ResponseAssignment
  +acknowledge(raId, officerId)
}

class ReportService {
  +generate(criteria) : ConservationReport
  +aggregate(snapshot)
  +export(id, format) : File
}

class LocalStore {
  +save(record)
  +pending() : List
  +markSynced(id)
  +status(id) : SyncState
}

class SyncService {
  +synchronize()
}

class ConservationAPI {
  +upsert(record) : Ack
  +query(criteria) : Snapshot
}

class NotificationGateway {
  +send(assignment) : DeliveryState
}

' ----- Relationships -----
Park "1" o-- "0..*" PatrolRoute
Park "1" o-- "0..*" Officer
Park "1" o-- "0..*" RiskZone
Park "1" o-- "0..*" IncidentReport

PatrolRoute "1" -- "0..*" Patrol
Officer "1" -- "0..*" Patrol

Patrol "1" *-- "0..*" Waypoint : composition
IncidentReport "1" *-- "0..*" PhotoAttachment : composition
ConservationReport "1" *-- "1" ReportCriteria : composition

Animal "0..1" -- "0..1" GPSCollar : active collar
GPSCollar "1" -- "0..*" LocationReading

RiskZone "1" -- "0..*" Alert
LocationReading "0..1" -- "0..*" Alert
CommunityReport "0..1" -- "0..1" Alert

Alert "1" -- "0..*" ResponseAssignment
ResponseAssignment "*" -- "1" Officer

@enduml
