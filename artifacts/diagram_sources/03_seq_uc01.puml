@startuml
' UC01 - Record an assigned patrol - Sequence Diagram

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam monochrome true
skinparam sequenceArrowThickness 1.5

actor Ranger
participant "PatrolView" as V
participant "PatrolService" as S
participant "LocalStore" as LS
participant "SyncService" as SY
participant "ConservationAPI" as API

== P1-P2 : Start assigned patrol ==
Ranger -> V : openRoute(RT-07)
activate V
V --> Ranger : route, map status, last sync
Ranger -> V : Start patrol
V -> S : startPatrol(routeId)
activate S
S -> LS : save(PT-104, ACTIVE)
activate LS
LS --> S : ok
deactivate LS
S --> V : PT-104 ACTIVE
deactivate S
V --> Ranger : patrol started
deactivate V

== P3 : Record waypoints ==
loop while patrol ACTIVE
  Ranger -> V : position (GPS or Manual)
  activate V
  V -> S : recordPoint(id, geo)
  activate S
  S -> LS : save(waypoint)
  activate LS
  LS --> S : ok
  deactivate LS
  S --> V : recorded
  deactivate S
  deactivate V
end

== P4 : Finish ==
Ranger -> V : Finish + confirm
activate V
V -> S : completePatrol(id)
activate S
S -> LS : save(COMPLETED, PENDING)
activate LS
LS --> S : ok
deactivate LS
S --> V : queued for sync
deactivate S
deactivate V

== P5-P6 : Synchronize ==
alt network available
  V -> SY : synchronize()
  activate SY
  SY -> LS : pending()
  activate LS
  LS --> SY : [PT-104]
  deactivate LS
  SY -> API : upsert(record)
  activate API
  API --> SY : Ack(version)
  deactivate API
  SY -> LS : markSynced(id)
  activate LS
  LS --> SY : ok
  deactivate LS
  SY --> V : Synced at 14:22
  deactivate SY
else remains offline
  V --> Ranger : status = PENDING
end

@enduml
